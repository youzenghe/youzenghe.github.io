---
/** Navigation-driven image banner with title overlays and waves. */
import NavigationBackground from "./NavigationBackground.astro";
import TypewriterText from "@components/atoms/typewriter-text/TypewriterText.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../config";
import { BANNER_HEIGHT_EXTEND } from "../../constants/constants";

interface Props {
	bannerImages?: {desktop: string | string[]; mobile: string | string[]};
	mobileNonHomeBannerClass?: string;
	showTextOverlay?: boolean;
	overlayTitle?: string;
	overlaySubtitle?: string | string[];
	typewriter?: boolean;
	showWave?: boolean;
}
const {
	mobileNonHomeBannerClass = "",
	showTextOverlay = false,
	overlayTitle = siteConfig.banner.homeText?.title,
	overlaySubtitle = siteConfig.banner.homeText?.subtitle,
	typewriter = siteConfig.banner.homeText?.typewriter?.enable ?? false,
	showWave = siteConfig.banner.waves?.enable ?? true,
} = Astro.props;
const hasBannerCredit = siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;
---
<div
	id="banner-wrapper"
	class:list={["absolute z-0 w-full transition duration-700 overflow-hidden",mobileNonHomeBannerClass]}
	style={`top: -${BANNER_HEIGHT_EXTEND}vh`}
>
	<NavigationBackground id="banner" position={siteConfig.banner.position} />

	<!-- 首页文字覆盖层 -->
	{siteConfig.banner.homeText?.enable && (
		<div class={`banner-text-overlay absolute inset-0 z-20 flex items-center justify-center ${!showTextOverlay ? "hidden" : ""}`}>
			<div class="w-4/5 lg:w-3/4 text-center mb-0">
				<div class="flex flex-col">
					{overlayTitle && (
						<h1 class="banner-title text-6xl lg:text-8xl text-white drop-shadow-lg mb-2 lg:mb-4">
							{overlayTitle}
						</h1>
					)}
					{overlaySubtitle && (
						<h2 class="banner-subtitle text-xl lg:text-3xl text-white/90 drop-shadow-md">
							<span class="inline-block min-h-[1.2em]">
								{typewriter && Array.isArray(overlaySubtitle) ? (
									<TypewriterText
										text={overlaySubtitle}
										speed={siteConfig.banner.homeText?.typewriter?.speed}
										deleteSpeed={siteConfig.banner.homeText?.typewriter?.deleteSpeed}
										pauseTime={siteConfig.banner.homeText?.typewriter?.pauseTime}
									/>
								) : Array.isArray(overlaySubtitle) ? (
									overlaySubtitle[0]
								) : (
									overlaySubtitle
								)}
							</span>
						</h2>
					)}
				</div>
			</div>
		</div>
	)}

	<!-- 非首页页面标题覆盖层（持久化容器，JS 动态填充文本） -->
	<div id="banner-page-overlay" class="banner-page-overlay hidden lg:flex absolute inset-0 z-20 pointer-events-none">
		<div class="flex flex-col items-center justify-center w-full text-center px-4">
			<h2 id="page-overlay-title" class="page-overlay-title text-3xl lg:text-5xl text-white font-bold drop-shadow-lg px-4"></h2>
			<div id="page-overlay-meta" class="page-overlay-meta hidden flex-wrap items-center justify-center gap-x-5 gap-y-2 text-white/80 text-sm md:text-base mt-4">
				<span class="inline-flex items-center gap-1.5">
					<Icon name="material-symbols:calendar-month-outline-rounded" class="text-[1.05em]" />
					<span id="page-overlay-date"></span>
				</span>
				<span class="inline-flex items-center gap-1.5">
					<Icon name="material-symbols:folder-outline" class="text-[1.05em]" />
					<span id="page-overlay-category"></span>
				</span>
				<span class="inline-flex items-center gap-1.5">
					<Icon name="material-symbols:ink-pen-outline-rounded" class="text-[1.05em]" />
					<span id="page-overlay-words"></span>
				</span>
			</div>
		</div>
	</div>

	<!-- 水波纹效果 -->
	{showWave && (
		<div
			class="waves absolute -bottom-px h-[10vh] max-h-37.5 min-h-12.5 w-full md:h-[15vh]"
			id="header-waves"
			style="transform: translateZ(0); will-change: fill;"
		>
			<svg
				class="waves"
				xmlns="http://www.w3.org/2000/svg"
				xmlns:xlink="http://www.w3.org/1999/xlink"
				viewBox="0 20 150 32"
				preserveAspectRatio="none"
				shape-rendering="auto"
				style="transform: translateZ(0); backface-visibility: hidden;"
			>
				<defs>
					<path
						id="gentle-wave"
						d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"
					>
					</path>
				</defs>
				<g class="parallax" style="transform: translateZ(0);">
					<use
						xlink:href="#gentle-wave"
						x="48"
						y="0"
						class="opacity-25 fill-(--page-bg)"
						style="animation-delay: -2s; animation-duration: 7s; will-change: transform;"
					></use>
					<use
						xlink:href="#gentle-wave"
						x="48"
						y="3"
						class="opacity-50 fill-(--page-bg)"
						style="animation-delay: -3s; animation-duration: 10s; will-change: transform;"
					></use>
					<use
						xlink:href="#gentle-wave"
						x="48"
						y="5"
						class="opacity-75 fill-(--page-bg)"
						style="animation-delay: -4s; animation-duration: 13s; will-change: transform;"
					></use>
					<use
						xlink:href="#gentle-wave"
						x="48"
						y="7"
						class="fill-(--page-bg)"
						style="animation-delay: -5s; animation-duration: 20s; will-change: transform;"
					></use>
				</g>
			</svg>
		</div>
	)}

	<!-- Banner 图片来源标注 -->
	{hasBannerCredit && (
		<a
			href={siteConfig.banner.credit.url}
			id="banner-credit"
			target="_blank"
			rel="noopener"
			aria-label="Visit image source"
			class:list={[
				"group onload-animation transition-all absolute flex justify-center items-center rounded-full px-3 right-4 -top-13 bg-black/60 hover:bg-black/70 h-9",
				{ "hover:pr-9 active:bg-black/80": hasBannerLink },
			]}
		>
			<Icon
				class="text-white/75 text-[1.25rem] mr-1"
				name="material-symbols:copyright-outline-rounded"
			/>
			<div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
			<Icon
				class:list={[
					"transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
					{ "group-hover:opacity-100": hasBannerLink },
				]}
				name="fa7-solid:arrow-up-right-from-square"
			>
			</Icon>
		</a>
	)}
</div>

<style>
	/* Banner 文本样式 */
	.banner-title {
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
		animation: fadeInUp 1s ease-out;
		font-weight: bold;
	}

	.banner-subtitle {
		text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.6);
		animation: fadeInUp 1s ease-out 0.3s both;
		min-height: 1.5em;
		line-height: 1.2;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
