---
import { Icon } from "astro-icon/components";

import { announcementConfig } from "../../../config";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import WidgetLayout from "../common/WidgetLayout.astro";

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
<WidgetLayout
	name={config.title || i18n(I18nKey.announcement)}
	id="announcement"
	class={className}
	style={style}
>
	<div>
		<!-- 公告栏内容 -->
		<div
			class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3"
		>
			{config.content.split("\n").map(line => <span class="announcement-line">{line}</span>)}
		</div>

		<!-- 可选链接和关闭按钮 -->
		<div class="flex items-center justify-between gap-3">
			<div>
				{
					config.link && config.link.enable !== false && (
						<a
							href={config.link.url}
							target={config.link.external ? "_blank" : "_self"}
							rel={
								config.link.external
									? "noopener noreferrer"
									: undefined
							}
							class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
						>
							{config.link.text}
						</a>
					)
				}
			</div>

			{
				config.closable && (
					<button
						class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
						onclick="closeAnnouncement()"
						aria-label={i18n(I18nKey.announcementClose)}
					>
						<Icon name="fa7-solid:xmark" class="text-sm" />
					</button>
				)
			}
		</div>
	</div>
</WidgetLayout>

<script>
	import { announcementConfig } from "../../../config/announcementConfig";
	import { dismissAnnouncement, isAnnouncementDismissed } from "../../../utils/announcement-state";

	const widgets = () => document.querySelectorAll<HTMLElement>('widget-layout[data-id="announcement"]');
	function syncAnnouncement() {
		let closed = false;
		try { closed = isAnnouncementDismissed(localStorage, announcementConfig.content); } catch { /* Storage getter may be restricted. */ }
		for (const widget of widgets()) widget.style.display = closed ? "none" : "";
	}
	function closeAnnouncement() {
		for (const widget of widgets()) widget.style.display = "none";
		try { dismissAnnouncement(localStorage, announcementConfig.content); } catch { /* Visual close does not need storage. */ }
	}
	window.closeAnnouncement = closeAnnouncement;
	if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", syncAnnouncement, { once: true });
	else syncAnnouncement();
	let hookedSwup: typeof window.swup;
	function bindSwup() {
		if (window.swup === hookedSwup) return;
		hookedSwup?.hooks.off("page:view", syncAnnouncement);
		hookedSwup = window.swup;
		hookedSwup?.hooks.on("page:view", syncAnnouncement);
	}
	document.addEventListener("swup:enable", bindSwup);
	document.addEventListener("astro:page-load", syncAnnouncement);
	bindSwup();
</script>

<style>
	.announcement-line { display: block; }
	.announcement-line + .announcement-line { white-space: nowrap; }
</style>
