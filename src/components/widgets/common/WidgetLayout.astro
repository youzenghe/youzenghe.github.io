---
import { Icon } from "astro-icon/components";

import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import { getWidgetContentId } from "../../../utils/widget-ids";

interface Props {
	id: string;
	name?: string;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	class?: string;
	style?: string;
}
const { id, name, isCollapsed, collapsedHeight, style } = Astro.props;
const className = Astro.props.class;
const contentId = getWidgetContentId(Astro.locals, id);
---

<widget-layout
	data-id={id}
	data-is-collapsed={String(isCollapsed)}
	class={"pb-4 card-base " + className}
	style={style}
>
	{
		name && (
			<div
				class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-4 mb-2 flex items-center
        before:w-1 before:h-4 before:rounded-md before:bg-(--primary)
        before:absolute before:-left-4 before:top-[5.5px]"
			>
				{name}
				<slot name="title-icon" />
			</div>
		)
	}
	<div
		id={contentId}
		class:list={[
			"collapse-wrapper px-4 overflow-hidden",
			{ collapsed: isCollapsed },
		]}
	>
		<slot />
	</div>
	{
		isCollapsed && (
			<div class="expand-btn px-4 -mb-2">
				<button type="button" class="btn-plain rounded-lg w-full h-9" aria-expanded="false" aria-controls={contentId}>
					<div class="text-(--primary) flex items-center justify-center gap-2 -translate-x-2">
						<Icon
							name="material-symbols:more-horiz"
							class="text-[1.75rem]"
						/>{" "}
						{i18n(I18nKey.more)}
					</div>
				</button>
			</div>
		)
	}
</widget-layout>

<style define:vars={{ collapsedHeight }}>
	.collapsed {
		height: var(--collapsedHeight);
	}
</style>

<script>
	class WidgetLayout extends HTMLElement {
		private trigger: HTMLButtonElement | null = null;
		private expand = () => {
			this.querySelector(".collapse-wrapper")?.classList.remove("collapsed");
			this.trigger?.setAttribute("aria-expanded", "true");
			this.querySelector(".expand-btn")?.classList.add("hidden");
		};

		connectedCallback() {
			if (this.dataset.isCollapsed !== "true") {
				return;
			}
			this.trigger = this.querySelector(".expand-btn button");
			this.trigger?.removeEventListener("click", this.expand);
			this.trigger?.addEventListener("click", this.expand);
		}

		disconnectedCallback() {
			this.trigger?.removeEventListener("click", this.expand);
			this.trigger = null;
		}
	}

	if (!customElements.get("widget-layout")) {
		customElements.define("widget-layout", WidgetLayout);
	}
</script>
