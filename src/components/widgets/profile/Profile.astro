---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../../config";
import { url } from "../../../utils/url-utils";
import TypewriterText from "../../atoms/typewriter-text/TypewriterText.astro";
---

<div class="card-base p-3">
	<a
		aria-label="Go to About Page"
		href={url("/about/")}
		class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
	>
		<div
			class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
		>
			<Icon
				name="fa7-regular:address-card"
				class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
			/>
		</div>
		<img
			src={url(profileConfig.avatar || "")}
			alt={`${profileConfig.name}的头像`}
			class="profile-avatar"
			width="256"
			height="256"
			decoding="async"
			loading="eager"
			fetchpriority="high"
		/>
	</a>
	<div class="px-2">
		<div
			class="profile-name font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
		>
			{profileConfig.name}
		</div>
		<div
			class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
		>
		</div>

		<div class="text-center text-neutral-600 dark:text-neutral-300 mb-2.5 transition">
			{
				profileConfig.typewriter?.enable ? (
					<TypewriterText
						text={profileConfig.bio || ""}
						speed={profileConfig.typewriter.speed}
						class="inline-block"
					/>
				) : (
					profileConfig.bio
				)
			}
		</div>

		<div class="profile-social-links">
			{
				profileConfig.links.length > 1 &&
					profileConfig.links.map((item) => (
						<a
							rel="me noopener noreferrer"
							aria-label={item.name}
							href={item.url}
							target="_blank"
							class="profile-social-link btn-regular rounded-lg active:scale-90"
						>
							<Icon name={item.icon} class="text-[1.5rem]" />
						</a>
					))
			}
			{
				profileConfig.links.length == 1 && (
					<a
						rel="me noopener noreferrer"
						aria-label={profileConfig.links[0].name}
						href={profileConfig.links[0].url}
						target="_blank"
						class="profile-social-link btn-regular rounded-lg gap-2 px-3 font-bold active:scale-95"
					>
						<Icon
							name={profileConfig.links[0].icon}
							class="text-[1.5rem]"
						/>
						{profileConfig.links[0].name}
					</a>
				)
			}
		</div>
	</div>
</div>

<style>
	.profile-avatar { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; }
	.profile-name { overflow-wrap: anywhere; line-height: 1.5; }
	.profile-social-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.875rem; margin: 0.75rem 0 0.25rem; }
	.profile-social-link { min-width: 2.75rem; min-height: 2.75rem; padding: 0.5rem; flex: 0 0 auto; }
</style>
