    "@iconify/svelte": "^5.2.4",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.1.3",
    "astro-expressive-code": "^0.44.4",
    "astro-icon": "^1.1.5",
    "axios": "^1.18.1",
    "dayjs": "^1.11.23",
    "hastscript": "^9.0.3",
    "katex": "^0.17.0",
    "l2d-widget": "^0.1.2",
    "markdown-it": "^14.3.3",
