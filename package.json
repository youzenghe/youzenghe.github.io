{
  "name": "acg-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "daily": "node scripts/submit_learning_note.mjs",
    "submit:learning": "node scripts/submit_learning_note.mjs",
    "optimize:uploads": "python scripts/optimize_upload_images.py",
    "build:thumbs": "python scripts/generate_thumbnails.py",
    "build:content": "python scripts/build_content.py",
    "build:rss": "python scripts/generate_rss.py",
    "build:sitemap": "python scripts/generate_sitemap.py",
    "build:fonts": "python scripts/build_fonts.py",
    "validate:content": "python scripts/validate_content.py",
    "prepare:site": "npm run optimize:uploads && npm run build:thumbs && npm run validate:content && npm run build:content && npm run check:data-split && npm run check:learning-navigation && npm run check:spa-router && npm run check:video-background && npm run build:rss && npm run build:sitemap && npm run build:fonts",
    "prebuild:dist": "npm run prepare:site",
    "build:dist": "node scripts/build_dist.mjs",
    "check:data-split": "node scripts/checks/check_data_split.mjs",
    "check:lazy-card-media": "node scripts/checks/check_lazy_card_media.mjs",
    "check:learning-navigation": "node scripts/checks/check_learning_navigation.mjs",
    "check:spa-router": "node scripts/checks/check_spa_router.mjs",
    "check:site-health": "node scripts/checks/check_site_health.mjs && node scripts/checks/check_site_health_page.mjs",
    "check:site-search": "node scripts/checks/check_site_search.mjs",
    "check:video-background": "node scripts/checks/check_video_background.mjs"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "terser": "^5.31.6"
  }
}
