{
  "name": "mizuki",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "9.0",
  "scripts": {
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "prepare:music": "node scripts/prepare-local-music.mjs",
    "dev:local": "node scripts/prepare-static-vendors.mjs && node scripts/prepare-local-music.mjs && astro dev --host 0.0.0.0",
    "build:local": "node scripts/prepare-static-vendors.mjs && node scripts/prepare-local-music.mjs && astro build --force && pagefind --site dist",
    "preview:static": "node scripts/preview-static.mjs",
    "check:links": "node scripts/check-static-links.mjs",
    "check:resources": "node scripts/check-static-resources.mjs",
    "check:styles": "node scripts/check-shared-styles.mjs",
    "dev": "node scripts/prepare-static-vendors.mjs && node scripts/prepare-local-music.mjs && astro dev",
    "dev-force": "node scripts/prepare-local-music.mjs && astro dev --force",
    "start": "astro dev",
    "check": "astro check",
    "build": "node scripts/prepare-static-vendors.mjs && node scripts/prepare-local-music.mjs && astro build --force && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit",
    "new-post": "node scripts/new-post.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.2.1",
